# Copy this file to .env and fill in your values. .env is git-ignored, never commit it.
# Environment variables with the same names take precedence over this file.

# ---- Server ----
# MongoDB connection string. For Atlas, copy it from Connect > Drivers and insert your password.
# If the password contains special characters (@ : / ? # %), URL-encode them.
JESMS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
JESMS_DB_NAME=JeSMS

# ---- Server and client ----
JESMS_PORT=9999

# ---- Client ----
JESMS_HOST=localhost
